{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Basebuild window",
  "windows": ["main"],
  "permissions": ["core:default", "dialog:allow-open", "core:window:allow-hide", "core:window:allow-show", "core:window:allow-set-focus", "core:window:allow-minimize", "core:window:allow-toggle-maximize", "core:window:allow-maximize", "core:window:allow-unmaximize", "core:window:allow-close", "core:window:allow-is-maximized", "core:window:allow-start-dragging", "core:window:allow-request-user-attention", "autostart:default"]
}
