{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basebuild.net/contracts/usage-envelope-v1.schema.json",
  "title": "Basebuild Desktop Usage Envelope v1",
  "oneOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/acknowledgement" }
  ],
  "$defs": {
    "source": {
      "type": "string",
      "enum": ["native", "omp", "claude-code", "codex", "opencode"]
    },
    "safeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]{0,127}$"
    },
    "safeLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\r\\n]{1,128}$"
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "modelUsageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "model",
        "requests",
        "inputTokens",
        "outputTokens",
        "cacheReadTokens",
        "cacheWriteTokens",
        "costTotal",
        "durationMs",
        "durationCount",
        "ttftMs",
        "ttftCount",
        "errors"
      ],
      "properties": {
        "kind": { "const": "model_usage" },
        "provider": { "$ref": "#/$defs/safeIdentifier" },
        "model": { "$ref": "#/$defs/safeIdentifier" },
        "effort": {
          "type": ["string", "null"],
          "enum": ["none", "low", "medium", "high", "xhigh", null]
        },
        "subscriptionTier": {
          "type": ["string", "null"],
          "enum": ["plus", "pro", "max", "free", "api", "team", "enterprise", null]
        },
        "subscriptionSource": {
          "type": ["string", "null"],
          "enum": ["declared", "provider-api", "api-key", "inferred", "unknown", null]
        },
        "planName": {
          "oneOf": [
            { "$ref": "#/$defs/safeLabel" },
            { "type": "null" }
          ]
        },
        "requests": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "inputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "outputTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cacheReadTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "cacheWriteTokens": { "$ref": "#/$defs/nonNegativeInteger" },
        "costTotal": { "$ref": "#/$defs/nonNegativeNumber" },
        "durationMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "durationCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "ttftMs": { "$ref": "#/$defs/nonNegativeInteger" },
        "ttftCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "errors": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "planUtilizationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "usedFraction", "remainingFraction"],
      "properties": {
        "kind": { "const": "plan_utilization" },
        "provider": { "$ref": "#/$defs/safeIdentifier" },
        "planType": {
          "oneOf": [
            { "$ref": "#/$defs/safeLabel" },
            { "type": "null" }
          ]
        },
        "windowLabel": {
          "type": ["string", "null"],
          "maxLength": 64,
          "pattern": "^[^\\r\\n]{1,64}$"
        },
        "usedFraction": { "$ref": "#/$defs/fraction" },
        "remainingFraction": { "$ref": "#/$defs/fraction" },
        "resetsAt": {
          "oneOf": [
            { "$ref": "#/$defs/nonNegativeInteger" },
            { "type": "null" }
          ]
        }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "idempotencyKey", "windowStart", "windowEnd", "rows"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:\\-]+$"
        },
        "windowStart": { "$ref": "#/$defs/nonNegativeInteger" },
        "windowEnd": { "$ref": "#/$defs/nonNegativeInteger" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/modelUsageRow" },
              { "$ref": "#/$defs/planUtilizationRow" }
            ]
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "generatedAt", "batches"],
      "properties": {
        "version": { "const": 1 },
        "generatedAt": { "$ref": "#/$defs/nonNegativeInteger" },
        "batches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/batch" }
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "idempotencyKey", "status"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
        "status": {
          "type": "string",
          "enum": ["accepted", "already_accepted", "rejected"]
        },
        "receiptId": {
          "oneOf": [
            { "$ref": "#/$defs/safeIdentifier" },
            { "type": "null" }
          ]
        },
        "processedAt": {
          "oneOf": [
            { "$ref": "#/$defs/nonNegativeInteger" },
            { "type": "null" }
          ]
        },
        "code": {
          "type": ["string", "null"],
          "enum": [
            "unsupported_version",
            "invalid_envelope",
            "invalid_timestamp",
            "invalid_batch_count",
            "invalid_batch",
            "source_not_allowed",
            "invalid_idempotency_key",
            "invalid_window",
            "invalid_rows",
            "too_many_rows",
            "invalid_row",
            "scope_denied",
            "token_revoked",
            "quota_exceeded",
            "idempotency_conflict",
            "receipt_unavailable",
            "processing_failed",
            null
          ]
        },
        "message": { "type": ["string", "null"], "maxLength": 256 }
      }
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "outcome", "receipts"],
      "properties": {
        "version": { "const": 1 },
        "outcome": {
          "type": "string",
          "enum": ["success", "partial", "failed", "nothing_to_sync"]
        },
        "receipts": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/receipt" }
        }
      }
    }
  },
  "x-basebuild-limits": {
    "requestBytes": 524288,
    "decompressedBytes": 1048576,
    "maxBatches": 5,
    "maxRowsPerBatch": 500,
    "maxRowsPerEnvelope": 1000,
    "maxIdentifierLength": 128,
    "maxFutureSkewSeconds": 300,
    "maxHistoricalAgeSeconds": 7776000,
    "maxWindowSeconds": 2678400
  }
}
